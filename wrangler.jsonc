{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customcare",
  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "CF_SKIP_IF_BUILT=1 node scripts/cf-build-if-needed.mjs"
  },
  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "customcare"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "CustomCare",
    "NEXT_PUBLIC_APP_URL": "https://getcustomcare.xyz",
    "NEXT_PUBLIC_INITIAL_CLIENT": "UltimateTechApp",
    "CAREFLOW_APP_BASE_URL": "https://getcustomcare.xyz",
    "CAREFLOW_AUTH_CALLBACK_URL": "https://getcustomcare.xyz/login",
    "CAREFLOW_ALLOWED_REDIRECT_URLS": "https://getcustomcare.xyz,https://www.getcustomcare.xyz,https://customcare.cloud111.workers.dev",
    "CAREFLOW_EMAIL_FROM_NAME": "CustomCare Security",
    "CAREFLOW_EMAIL_FROM_ADDRESS": "security@getcustomcare.xyz",
    "CAREFLOW_ENFORCE_ADMIN_MFA": "false"
  }
}
