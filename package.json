{
  "name": "careflow",
  "private": true,
  "version": "0.1.0",
  "description": "CareFlow — Smarter Support. Better Experiences. Modular customer support platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev apps/web -p 3000 -H 0.0.0.0",
    "build": "node scripts/build.mjs",
    "cf:build": "node scripts/cf-build-if-needed.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:deploy": "npx wrangler deploy",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next start apps/web -p 3000 -H 0.0.0.0",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-test-loader.mjs --experimental-transform-types --test tests/knowledge-stage1.test.ts tests/onboarding-multi-business.test.ts tests/auth-security-system.test.ts tests/multichannel-support-os.test.ts",
    "push": "node scripts/git-push.mjs",
    "clean": "rm -rf apps/web/.next apps/web/.open-next dist"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
