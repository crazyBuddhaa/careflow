# ==============================================================================
# CustomCare Environment Configuration (v0.1.0 — getcustomcare.xyz)
# Target Infrastructure: Cloudflare Workers + D1 + R2 + GitHub
# ==============================================================================

# Application Metadata
NEXT_PUBLIC_APP_NAME="CustomCare"
NEXT_PUBLIC_APP_URL="https://getcustomcare.xyz"
NEXT_PUBLIC_INITIAL_CLIENT="UltimateTechApp"

# Supabase Public Configuration (Safe for Browser & Widget)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Supabase Server-Only Configuration (NEVER expose to browser / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Future Channel Integrations (Reserved for v0.2+)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Stage 1 — Admin Workspace Session & Local D1/SQLite Persistence (Server-Only)
CAREFLOW_ADMIN_SESSION_SECRET="replace-with-at-least-32-character-random-secret"
CAREFLOW_ADMIN_PASSCODE="careflow-dev-admin"
CAREFLOW_SQLITE_PATH=""

# CustomCare Authentication & URL Configuration (getcustomcare.xyz)
CAREFLOW_APP_BASE_URL="https://getcustomcare.xyz"
CAREFLOW_AUTH_CALLBACK_URL="https://getcustomcare.xyz/login"
CAREFLOW_ALLOWED_REDIRECT_URLS="https://getcustomcare.xyz,https://www.getcustomcare.xyz"
CAREFLOW_ENFORCE_ADMIN_MFA="false"

# Resend Transactional Email Configuration (Server-Only Cloudflare Worker Secret)
RESEND_API_KEY=""
CAREFLOW_EMAIL_FROM_ADDRESS="security@getcustomcare.xyz"
CAREFLOW_EMAIL_FROM_NAME="CustomCare Security"

# Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# GitHub Repository Push Token (Set in AI Studio Secrets / Environment Variables)
GITHUB_TOKEN=""

# Cloudflare CLI Automation Token (Used by `npm run cf:setup` & Wrangler in headless environments)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
